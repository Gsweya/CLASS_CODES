<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!DOCTYPE students [

  <!-- Root element: one or more student elements -->
  <!ELEMENT students (student+)>
  <!ATTLIST students
      college       CDATA #REQUIRED
      academicYear  CDATA #REQUIRED>

  <!-- A student: child elements MUST appear in exactly this order -->
  <!ELEMENT student (firstName, lastName, programme, yearOfStudy, email, phone, courses)>
  <!ATTLIST student
      regNo   ID              #REQUIRED
      gender  (Male | Female) #REQUIRED>

  <!-- Simple text elements -->
  <!ELEMENT firstName   (#PCDATA)>
  <!ELEMENT lastName    (#PCDATA)>
  <!ELEMENT programme   (#PCDATA)>
  <!ELEMENT yearOfStudy (#PCDATA)>
  <!ELEMENT email       (#PCDATA)>
  <!ELEMENT phone       (#PCDATA)>

  <!-- Courses: at least three course elements per student -->
  <!ELEMENT courses (course, course, course, course*)>
  <!ELEMENT course  (#PCDATA)>
  <!ATTLIST course
      code     CDATA #REQUIRED
      credits  CDATA #IMPLIED>
]>

