<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/lightblue"
    tools:context=".MainActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Title -->
        <TextView
            android:id="@+id/Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/homeTitle"
            android:textSize="32sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- First Name -->
        <TextView
            android:id="@+id/fName"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="@string/fName"
            android:layout_below="@id/Title"
            android:layout_marginTop="40dp"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etFName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your first name"
            android:inputType="textPersonName"
            android:layout_toEndOf="@id/fName"
            android:layout_alignBaseline="@id/fName"
            android:layout_marginStart="16dp" />

        <!-- Last Name -->
        <TextView
            android:id="@+id/lName"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="@string/lName"
            android:layout_below="@id/fName"
            android:layout_marginTop="30dp"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etLName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your last name"
            android:inputType="textPersonName"
            android:layout_toEndOf="@id/lName"
            android:layout_alignBaseline="@id/lName"
            android:layout_marginStart="16dp" />

        <!-- Surname -->
        <TextView
            android:id="@+id/sName"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="@string/sName"
            android:layout_below="@id/lName"
            android:layout_marginTop="30dp"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etSName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your surname"
            android:inputType="textPersonName"
            android:layout_toEndOf="@id/sName"
            android:layout_alignBaseline="@id/sName"
            android:layout_marginStart="16dp" />

        <!-- Age -->
        <TextView
            android:id="@+id/age"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="@string/age"
            android:layout_below="@id/sName"
            android:layout_marginTop="30dp"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/etAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter your age"
            android:inputType="number"
            android:maxLength="3"
            android:layout_toEndOf="@id/age"
            android:layout_alignBaseline="@id/age"
            android:layout_marginStart="16dp" />

        <!-- Gender -->
        <TextView
            android:id="@+id/gender"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="@string/gender"
            android:layout_below="@id/age"
            android:layout_marginTop="30dp"
            android:textSize="18sp" />

        <RadioGroup
            android:id="@+id/radioGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/gender"
            android:layout_alignBaseline="@id/gender"
            android:layout_marginStart="16dp"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/male"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Male" />

            <RadioButton
                android:id="@+id/female"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Female" />
        </RadioGroup>

        <!-- Courses -->
        <TextView
            android:id="@+id/courses"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="@string/courses"
            android:layout_below="@id/radioGender"
            android:layout_marginTop="20dp"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/coursesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/courses"
            android:layout_alignTop="@id/courses"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/cbCp311"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CP 311" />

            <CheckBox
                android:id="@+id/cbCp313"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CP 313" />

            <CheckBox
                android:id="@+id/cbIa313"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IA 313" />

            <CheckBox
                android:id="@+id/cbEme314"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EME 314" />

            <CheckBox
                android:id="@+id/cbBt314"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BT 314" />
        </LinearLayout>

        <!-- College (drop down) -->
        <TextView
            android:id="@+id/college"
            android:layout_width="120dp"
            android:layout_height="wrap_content"
            android:text="@string/college"
            android:layout_below="@id/coursesContainer"
            android:layout_marginTop="30dp"
            android:textSize="18sp" />

        <Spinner
            android:id="@+id/spinnerCollege"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/udom_colleges"
            android:layout_toEndOf="@id/college"
            android:layout_alignTop="@id/college"
            android:layout_marginStart="16dp" />

        <!-- Submit -->
        <Button
            android:id="@+id/btnSubmit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/college"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="40dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/submit"
            android:textSize="16sp" />

    </RelativeLayout>
</ScrollView>
