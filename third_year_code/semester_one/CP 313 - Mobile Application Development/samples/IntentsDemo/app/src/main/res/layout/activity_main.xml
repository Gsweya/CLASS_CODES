<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== 1. EXPLICIT INTENT, no data ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Explicit intent (open another screen)"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnOpenSecond"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Second Screen" />

        <!-- ===== 2. EXPLICIT INTENT + DATA ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. Send data to another screen"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your name"
            android:inputType="textPersonName" />

        <EditText
            android:id="@+id/etAge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your age"
            android:inputType="number" />

        <CheckBox
            android:id="@+id/cbStudent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="I am a student" />

        <Button
            android:id="@+id/btnSendData"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send to Profile Screen" />

        <!-- ===== 3. GET A RESULT BACK ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. Get data back from a screen"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnChooseCollege"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Choose College" />

        <TextView
            android:id="@+id/tvCollege"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No college chosen yet"
            android:textSize="16sp" />

        <!-- ===== 4. IMPLICIT INTENTS ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="4. Implicit intents (other apps do the job)"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnWebsite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open UDOM website" />

        <Button
            android:id="@+id/btnDial"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Dial a number" />

        <Button
            android:id="@+id/btnMap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Dodoma on a map" />

        <Button
            android:id="@+id/btnEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Write an email" />

        <Button
            android:id="@+id/btnShare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Share text" />
    </LinearLayout>
</ScrollView>
